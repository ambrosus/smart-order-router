{
  "name": "@airdao/astra-smart-order-router",
  "version": "1.0.0",
  "description": "Astra Smart Order Router",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ambrosus/smart-order-router.git"
  },
  "license": "GPL",
  "keywords": [],
  "scripts": {
    "compile-cl-types": "npx typechain --target ethers-v5 --out-dir src/types/cl './node_modules/@airdao/astra-cl-?(core|periphery)/artifacts/contracts/**/*[!.dbg].json'",
    "compile-classic-types": "npx typechain --target ethers-v5 --out-dir src/types/classic './node_modules/@airdao/astra-contracts/artifacts/contracts/**/*Astra*[!.dbg].json'",
    "compile-router": "npx typechain --target ethers-v5 --out-dir src/types/other './node_modules/@airdao/swap-router-contracts/artifacts/contracts/**/*[!.dbg].json'",
    "compile-external-types": "npx typechain --target ethers-v5 --out-dir src/types/other 'src/abis/**/*[!.dbg].json'",
    "build": "run-p compile-cl-types compile-classic-types compile-router compile-external-types && run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --ext .ts --fix",
    "prepare-release": "run-s cov:check doc:html version doc:publish",
    "test": "jest test/unit",
    "integ-test": "TS_NODE=true jest test/integ"
  },
  "engines": {
    "node": ">=10"
  },
  "dependencies": {
    "@airdao/astra-router-sdk": "npm:astra-router-sdk@^0.1.8",
    "@airdao/astra-sdk-core": "npm:astra-sdk-core@0.1.4",
    "@airdao/astra-universal-router-sdk": "npm:astra-universal-router-sdk@^0.1.9",
    "@airdao/astra-classic-sdk": "npm:astra-classic-sdk@^0.1.5",
    "@airdao/astra-cl-sdk": "npm:astra-cl-sdk-dev@^0.1.7",
    "@airdao/astra-permit2-sdk": "npm:astra-permit2-sdk@^0.1.1",
    "@airdao/swap-router-contracts": "^1.0.1",
    "@airdao/astra-universal-router": "^1.0.2",
    "@uniswap/default-token-list": "^11.2.0",
    "@uniswap/token-lists": "^1.0.0-beta.31",
    "async-retry": "^1.3.1",
    "await-timeout": "^1.1.1",
    "axios": "^0.21.1",
    "bunyan": "^1.8.15",
    "bunyan-blackhole": "^1.1.1",
    "ethers": "^5.7.2",
    "graphql": "^15.5.0",
    "graphql-request": "^3.4.0",
    "lodash": "^4.17.21",
    "mnemonist": "^0.38.3",
    "node-cache": "^5.1.2",
    "stats-lite": "^2.2.0"
  },
  "devDependencies": {
    "@ethersproject/providers": "^5.4.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.1",
    "@nomiclabs/hardhat-ethers": "^2.2.2",
    "@oclif/command": "^1.8.0",
    "@oclif/errors": "^1.3.5",
    "@typechain/ethers-v5": "^10.2.1",
    "@typechain/hardhat": "^6.1.6",
    "@types/async-retry": "^1.4.4",
    "@types/await-timeout": "^0.3.1",
    "@types/bunyan": "^1.8.6",
    "@types/bunyan-blackhole": "^0.2.2",
    "@types/jest": "^27.0.0",
    "@types/jest-sinon": "^1.0.2",
    "@types/lodash": "^4.14.168",
    "@types/node": "^15.0.2",
    "@types/sinon": "^10.0.2",
    "@types/stats-lite": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "@airdao/astra-contracts": "^1.0.2",
    "@airdao/astra-cl-core": "^1.0.0",
    "@airdao/astra-cl-periphery": "^1.0.0",
    "bunyan-debug-stream": "^2.0.0",
    "dotenv": "^10.0.0",
    "eslint": "^7.8.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.22.0",
    "hardhat": "^2.22.17",
    "jest": "^27.0.6",
    "jest-environment-hardhat": "^1.1.8",
    "jest-expect-message": "^1.0.2",
    "jest-mock": "^27.0.6",
    "jest-sinon": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "open-cli": "^6.0.1",
    "prettier": "^2.1.1",
    "prettier-plugin-organize-imports": "^2.1.0",
    "sinon": "^11.1.2",
    "ts-jest": "^27.0.4",
    "ts-node": "^10.8.1",
    "typechain": "^8.3.2",
    "typescript": "4.7.2"
  },
  "peerDependencies": {
    "jsbi": "^3.2.0"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true
  },
  "oclif": {
    "commands": "./cli/commands"
  }
}